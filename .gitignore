# ============================================================
# SISTEMA OPERACIONAL
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ============================================================
# NODE / DEPENDÊNCIAS
# ============================================================
node_modules/
yarn.lock
pnpm-lock.yaml
.npm/
.yarn/
.pnp.js
.pnp.cjs

# ⚠️  NÃO ignorar package-lock.json — ele DEVE ser commitado
#     (build determinístico na Vercel)

# ============================================================
# LOGS
# ============================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# VARIÁVEIS DE AMBIENTE
# ------------------------------------------------------------
# ⚠️  NUNCA commite arquivos .env reais.
#     Use .env.example (commitado) como template.
# ============================================================
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
.env*.local

# ✅ Exceção: template documentado
!.env.example

# ============================================================
# SEGREDOS / CHAVES / CERTIFICADOS
# ============================================================
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
credentials.json
service-account*.json

# ============================================================
# VERCEL / DEPLOY
# ============================================================
.vercel
.now
.netlify
.netlify.toml

# ============================================================
# EDITORES / IDEs
# ============================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ============================================================
# HISTÓRICO LOCAL (VSCode)
# ============================================================
.history/

# ============================================================
# BUILD / CACHE
# ============================================================
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
.vite/
.turbo/

# ============================================================
# TESTES / COBERTURA
# ============================================================
coverage/
.nyc_output/
*.lcov

# ============================================================
# ÁUDIOS LOCAIS (grandes — não commitar)
# ------------------------------------------------------------
# O projeto usa Supabase Storage para áudios. Esta pasta é
# apenas para arquivos temporários de desenvolvimento local.
# ============================================================
assets/audio/*.mp3
assets/audio/*.wav
assets/audio/*.ogg
assets/audio/*.m4a
assets/audio/*.flac
!assets/audio/.gitkeep

# ============================================================
# IMAGENS PESADAS (> 5MB — otimizar antes de subir)
# ============================================================
assets/img/*.psd
assets/img/*.ai
assets/img/*.tiff
assets/img/raw/
